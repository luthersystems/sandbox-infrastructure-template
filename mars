#!/bin/bash

set -eo pipefail

DEV_MOUNTS=''
if [[ "$MARS_DEV" == "true" ]]; then
  DEFAULT_MARS_DEV_ROOT="$(dirname "$(greadlink -f "$(which mars)")")"
  MARS_DEV_ROOT=${MARS_DEV_ROOT:-$DEFAULT_MARS_DEV_ROOT}
  DEV_MOUNTS="-v ${MARS_DEV_ROOT}/ansible-roles:/opt/ansible/roles:ro \
                -v ${MARS_DEV_ROOT}/ansible-plugins:/opt/ansible/plugins:ro"
  if [[ -n "${MARS_DEV_BINARY:-}" ]]; then
    DEV_MOUNTS="-v ${MARS_DEV_BINARY}:/opt/mars/mars:ro ${DEV_MOUNTS}"
  fi
  if [[ -n "${MARS_DEV_ENTRYPOINT:-}" ]]; then
    DEV_MOUNTS="-v ${MARS_DEV_ENTRYPOINT}:/opt/mars/mars-entrypoint:ro ${DEV_MOUNTS}"
  fi
  if [[ -n "${MARS_DEV_VAULT_AWS:-}" ]]; then
    DEV_MOUNTS="-v ${MARS_DEV_VAULT_AWS}:/opt/mars/vault-aws-secretsmanager:ro ${DEV_MOUNTS}"
  fi
  if [[ -n "${MARS_DEV_VAULT_AZ:-}" ]]; then
    DEV_MOUNTS="-v ${MARS_DEV_VAULT_AZ}:/opt/mars/vault-az-keyvault:ro ${DEV_MOUNTS}"
  fi
fi

if [[ "$MARS_DEBUG" == "true" ]]; then
  set -x
fi

fullpath() {
  cd "$1" && pwd
}

getroot() {
  GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -z "${PROJECT_PATH:-}" ]; then
    if [ -n "$GIT_ROOT" ]; then
      PROJECT_PATH="$GIT_ROOT"
    fi
  fi
}

CLONE_DIR=${CLONE_DIR:-$HOME}

TFENV_CACHE_PATH="$CLONE_DIR/.mars/tfenv/versions"

# Cache directory for provider plugins
TF_PLUGIN_CACHE_DIR="$CLONE_DIR/.mars/tf-plugin-cache"

ANSIBLE_HYPERLEDGER_DIR="$CLONE_DIR/.mars/hyperledger"
ANSIBLE_CHARTS_DIR="$CLONE_DIR/.mars/helmcharts"

DOCKER_IMAGE=luthersystems/mars
DOCKER_PROJECT_PATH=/marsproject
getroot
PROJECT_PATH=$(fullpath "${PROJECT_PATH:-$(pwd)}")
WORK_REL_PATH="${PWD#$PROJECT_PATH}" # Includes leading dir separator
DOCKER_WORK_DIR="$DOCKER_PROJECT_PATH$WORK_REL_PATH"

MARS_VERSION=latest
if [ -f "$PROJECT_PATH/.mars-version" ]; then
  MARS_VERSION=$(cat "$PROJECT_PATH/.mars-version")
elif [ -f "$GIT_ROOT/.mars-version" ]; then
  MARS_VERSION=$(cat "$GIT_ROOT/.mars-version")
fi

ENV_VARS=
if [ -n "${TF_LOG+x}" ]; then
  # TF_LOG has been set.  Forward it to the docker env.
  ENV_VARS="-e TF_LOG=$TF_LOG $ENV_VARS"
fi

DOCKER_TERM_VARS=-i
if [ -t 1 ] && [ ! -p /dev/stdin ]; then
  DOCKER_TERM_VARS=-it
fi

SHELL_OPTS=
if [[ "$MARS_SHELL" == "true" ]]; then
  SHELL_OPTS="--entrypoint /bin/bash"
fi

mkdir -p "$TFENV_CACHE_PATH"
mkdir -p "$TF_PLUGIN_CACHE_DIR"
mkdir -p "$ANSIBLE_HYPERLEDGER_DIR"
mkdir -p "$ANSIBLE_CHARTS_DIR"

# Run mars as the caller, so what it writes to the checkout and the caches
# mounted below stays the caller's, not root's (#187). The image runs as any
# uid from luthersystems/mars#363 (v0.147.0) on: mars-entrypoint gives the
# uid a passwd entry, so ssh works. USER_ID/GROUP_ID are not passed: they
# only ask a root-started container to switch user, which is no longer
# needed, and the entrypoint refuses them when the container did not start
# as root. Root (0:0, with no USER_ID, so mars stays root) is kept for:
#   - MARS_SHELL=true, whose bash entrypoint skips mars-entrypoint, so the
#     uid would get no passwd entry;
#   - an ansible command (run-ansible.sh, deploy.yml): mars's umbrella role
#     chowns its chart directory to root ("Create umbrella chart
#     directory"), which a non-root uid cannot do. ui-infrastructure hit
#     this on every deploy (luthersystems/ui-infrastructure#611). Drop this
#     case once luthersystems/mars#367 is fixed;
#   - a pin that is not a release vX.Y.Z at or after v0.147.0: an older
#     image cannot run as another uid, and latest (or any other tag) may be
#     a cached image older than v0.147.0;
#   - rootless Docker, user namespace remapping (userns-remap) and podman's
#     docker shim, where container root already maps to the caller (or a
#     subordinate uid) and --user with the caller's uid would not.
# So in practice Terraform runs as the caller and ansible as root. The
# cheap checks come first, so a run that is root anyway makes no daemon
# call.
mars_version_runs_as_any_uid() {
  [[ "$MARS_VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] &&
    [[ "$(printf '%s\n' "$MARS_VERSION" v0.147.0 | sort -V | head -n1)" == v0.147.0 ]]
}
# The daemon's output goes into a variable before it is matched: piping it
# into grep -q makes docker die of SIGPIPE when grep exits early, and under
# pipefail that failure would hide the match.
docker_remaps_root() {
  local version_out security_opts
  version_out="$(docker --version 2>/dev/null || true)"
  if [[ "$version_out" == *[Pp]odman* ]]; then
    return 0
  fi
  security_opts="$(docker info --format '{{.SecurityOptions}}' 2>/dev/null || true)"
  [[ "$security_opts" == *rootless* || "$security_opts" == *name=userns* ]]
}
RUN_USER="$(id -u):$(id -g)"
if [[ "$MARS_SHELL" == "true" ]]; then
  RUN_USER=0:0
elif [[ "${2:-}" == ansible* ]]; then
  RUN_USER=0:0
elif ! mars_version_runs_as_any_uid; then
  RUN_USER=0:0
elif docker_remaps_root; then
  RUN_USER=0:0
fi

# Before #187 this wrapper ran every command as root, so a checkout or cache
# it wrote to can hold root-owned files that a run as the caller cannot
# overwrite. Give them back to the caller from a root container (the caller
# can run docker, so no sudo is needed). Only uid 0's files: another user's
# files stay theirs. A failure warns and mars still runs.
reclaim() {
  local dir
  for dir in "$@"; do
    [ -d "$dir" ] || continue
    if [ -n "$(find "$dir" -user 0 -print -quit 2>/dev/null)" ]; then
      echo >&2 "mars: giving root-owned files that an earlier run left in $dir to $(id -u):$(id -g)"
      docker run --rm --user 0:0 --entrypoint find \
        --mount "type=bind,src=$dir,dst=/reclaim" \
        "$DOCKER_IMAGE:$MARS_VERSION" /reclaim -user 0 -exec chown -h "$(id -u):$(id -g)" {} + ||
        echo >&2 "mars: could not give every file in $dir back; continuing"
    fi
  done
}
if [[ "$RUN_USER" != "0:0" ]]; then
  # Only what a run as the caller writes: the checkout, which an earlier
  # root run wrote to (tf/*/.terraform, plans, auto-vars copies), and the
  # Terraform caches. Not the ansible caches (ANSIBLE_HYPERLEDGER_DIR,
  # ANSIBLE_CHARTS_DIR): ansible still runs as root and refills them, so
  # reclaiming them would start a chown container on every Terraform run
  # after an ansible run, for files Terraform never touches. The checkout
  # only when it is a git checkout: outside one, PROJECT_PATH is just the
  # current directory.
  reclaim ${GIT_ROOT:+"$PROJECT_PATH"} "$TFENV_CACHE_PATH" "$TF_PLUGIN_CACHE_DIR"
fi

docker run --rm $DOCKER_TERM_VARS \
  --network host \
  --user "$RUN_USER" \
  -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_SESSION_TOKEN \
  -e TF_PLUGIN_CACHE_DIR=/opt/tf-plugin-cache-dir \
  $ENV_VARS \
  $DEV_MOUNTS \
  -v "$TFENV_CACHE_PATH:/opt/tfenv/versions" \
  -v "$TF_PLUGIN_CACHE_DIR:/opt/tf-plugin-cache-dir" \
  -v "$ANSIBLE_HYPERLEDGER_DIR:/opt/hyperledger" \
  -v "$ANSIBLE_CHARTS_DIR:/opt/k8s/helmcharts" \
  -v "$PROJECT_PATH:$DOCKER_PROJECT_PATH" \
  -w "$DOCKER_WORK_DIR" \
  -e ANSIBLE_LOAD_CALLBACK_PLUGINS=yes \
  -e ANSIBLE_STDOUT_CALLBACK=yaml \
  -e ANSIBLE_TRANSPORT=local \
  -e ANSIBLE_FORCE_COLOR=True \
  $SHELL_OPTS \
  "$DOCKER_IMAGE:$MARS_VERSION" "$@"
