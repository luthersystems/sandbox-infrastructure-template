# ─────────────────────────────────────────────────────────────────────────────
# Scoped deploy policy body (issues #147, #194).
#
# ./policies/insideout-write.json is generated by cmd/policygen of
# luthersystems/insideout-terraform-presets (scripts/policygen.sh; CI runs it
# with -check). It has Terraform template placeholders: ${project},
# ${workload_boundary_arn}, ${deploy_role_arn} and ${deploy_policy_arn}.
#
# tf/cloud-provision attaches it to the durable terraform role when
# deploy_policy_mode = "scoped" and fills the placeholders. This stage's
# bootstrap_role keeps the admin-equivalent body (main.tf). The output below
# keeps the body visible in this stage's plan.
# ─────────────────────────────────────────────────────────────────────────────

output "insideout_write_policy_scaffold" {
  description = "Generated scoped InsideOutWrite body, with its placeholders (#147, #194). Not attached by this stage; cloud-provision attaches it to the terraform role when deploy_policy_mode = scoped."
  value       = file("${path.module}/policies/insideout-write.json")
}
