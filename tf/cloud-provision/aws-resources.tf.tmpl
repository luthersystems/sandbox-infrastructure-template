# AWS resources — activated at deploy time by _selectCloudFiles()
# Only present when cloud_provider = aws.

locals {
  admin_role_name = "${var.short_project_id}-luther-terraform"
  admin_role_arn  = module.bootstrap[0].admin_role
}

# ============================================================================
# AWS Bootstrap
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Least-privilege deploy role — Phase 0 (issue #147), durable-role half:
# docs/design/least-privilege-deploy-role.md §8.1 — "swap the role first,
# tighten later". Mirrors tf/account-setup/main.tf (the bootstrap_role half,
# merged in #157) for the durable `<short_project_id>-luther-terraform` role
# provisioned by tf-modules//aws-platform-ui-bootstrap (inputs added in
# tf-modules#71, released v55.23.0). PERMISSION-NEUTRAL by design:
#
#   * deploy_policy_json below is the same brand-new CUSTOMER-MANAGED
#     InsideOutWrite body as account-setup's — Phase-0 content is
#     admin-equivalent (Allow * on *), the same effective surface as the
#     AWS-managed AdministratorAccess it replaces inside the module. Real
#     deploys behave exactly as today; only the attached policy OBJECT (the
#     identity) changes.
#   * The role name/ARN is unchanged (the module keeps the attachment's
#     resource address too — tf-modules#71 deliberately did not count-gate
#     it), so every downstream consumer of `terraform_role` (the vm/k8s/
#     custom-stack backend role_arn, cached STS/Oracle paths) and the #2243
#     preflight — which simulates ACTIONS against the role ARN, never a
#     policy name (design doc §6(a)/§6(c)) — keep working across the swap.
#   * Rollback: set deploy_policy_json / permissions_boundary_arn back to ""
#     (module defaults) and re-apply — the module re-attaches
#     arn:aws:iam::aws:policy/AdministratorAccess and drops the boundary.
#
# deploy_policy_mode = "scoped" (#194, below) narrows only the BODY of the
# module-created policy (an in-place CreatePolicyVersion, never a role/ARN
# change) to the generated tf/account-setup/policies/insideout-write.json. It
# is opt-in per project; admin stays the default until the §8.2 CloudTrail
# shadow phase accepts the scoped policy.
# ─────────────────────────────────────────────────────────────────────────────

# Deny-only boundary body — read cross-stage from account-setup, whose
# policies/insideout-deploy-boundary.json is the single source of truth for
# BOTH deploy roles (it is generator-output; see
# tf/account-setup/policies/README.md). The cross-stage file() is safe here:
# the template repo is always one tree at plan time (CI checks out the whole
# repo; at deploy time mars mounts the git root, and this stage already
# writes cross-stage via local_file to ../vm-provision et al.). Deny-only ⇒
# non-enforcing for real deploy usage; safe to attach in Phase 0 per design
# doc §4 option 3 / §8.1.
resource "aws_iam_policy" "insideout_deploy_boundary" {
  name        = "${local.admin_role_name}-insideout-deploy-boundary"
  description = "Deny-only permission boundary for the durable InsideOut terraform role (#147 Phase 0 defense-in-depth)."
  policy      = file("${path.module}/../account-setup/policies/insideout-deploy-boundary.json")

  # Tagged like the inspector role this stage creates. Tagging a policy at
  # create time requires iam:TagPolicy, which the §6(b) preflight companion
  # change covers: reliable#2259 (bootstrapAWSIAMActions, shipped in reliable
  # v0.62.0) and template#158 (aws-preflight.sh REQUIRED_ACTIONS) both
  # simulate it, so a credential that passes preflight can apply this change.
  tags = {
    Project   = var.project_id
    ManagedBy = "terraform"
    Purpose   = "insideout-deploy-boundary"
  }

  # Here because this policy is always created on AWS; the workload boundary
  # is not created without stack_project (#194).
  lifecycle {
    precondition {
      condition     = var.deploy_policy_mode != "scoped" || var.stack_project != ""
      error_message = "deploy_policy_mode = \"scoped\" needs stack_project, the composer project name (io-<session>)."
    }
  }
}

# ============================================================================
# Deploy policy mode (#194)
# ============================================================================
#
# admin (default): the Phase-0 admin-equivalent body, as before.
#
# scoped: the policy cmd/policygen of the presets generates
# (../account-setup/policies/insideout-write.json, checked by
# scripts/policygen.sh -check). It grants the services the presets use, and
# IAM writes only under /insideout/<stack_project>/, only for roles that carry
# the workload boundary below. The deploy role cannot change its own role,
# its policy or the boundary. This stage fills the policy's placeholders.
#
# The composed stack's presets put their IAM on that path with that boundary
# when they get iam_scope; this stage writes it to
# ../auto-vars/iam_scope.auto.tfvars.json, which custom-stack-provision loads.
#
# Limits:
#   * custom-stack sequence only: vm-provision and k8s-provision make roles
#     off the project path, which the scoped policy refuses.
#   * The composed archive must come from a presets version that declares
#     the iam_scope root variable (insideout-terraform-presets#946).
#   * Moving to scoped replaces the stack's preset roles (new path and
#     boundary).
#
# The boundary exists whenever stack_project is set, in either mode. So a
# project moved back to admin keeps it while its roles still use it; IAM
# refuses to delete a boundary in use.

data "aws_caller_identity" "current" {}

data "aws_partition" "current" {}

locals {
  # Without stack_project, scoped mode fails the precondition on
  # aws_iam_policy.insideout_deploy_boundary; until then nothing reads the
  # missing boundary.
  scoped_deploy  = var.deploy_policy_mode == "scoped" && var.stack_project != ""
  iam_arn_prefix = "arn:${data.aws_partition.current.partition}:iam::${data.aws_caller_identity.current.account_id}:"

  # The boundary's ARN from its name, not from the resource: the scoped body
  # must be known at plan, because the bootstrap module counts its deploy
  # policy on it. On a first deploy the boundary does not exist yet.
  workload_boundary_arn = "${local.iam_arn_prefix}policy/${var.stack_project}-workload-boundary"

  admin_deploy_policy_json = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "AdminEquivalentPhase0"
        Effect   = "Allow"
        Action   = "*"
        Resource = "*"
      }
    ]
  })

  # jsonencode(jsondecode()) drops the whitespace. IAM does not count it
  # against the 6,144-character limit, but the stored body is smaller.
  scoped_deploy_policy_json = local.scoped_deploy ? jsonencode(jsondecode(templatefile("${path.module}/../account-setup/policies/insideout-write.json", {
    project               = var.stack_project
    workload_boundary_arn = local.workload_boundary_arn
    # tf-modules aws-platform-ui-bootstrap names them so, at path "/".
    deploy_role_arn   = "${local.iam_arn_prefix}role/${local.admin_role_name}"
    deploy_policy_arn = "${local.iam_arn_prefix}policy/${local.admin_role_name}-deploy"
  }))) : ""

  iam_scope = local.scoped_deploy ? {
    path                 = "/insideout/${var.stack_project}/"
    permissions_boundary = local.workload_boundary_arn
  } : null
}

# The cap on every role the composed stack makes in scoped mode. It is off
# the project path, so the deploy role's project IAM grants do not reach it,
# and the deploy policy denies changing it. Tagged with project_id like this
# stage's other IAM, not with stack_project: the deploy policy may delete
# IAM that carries the stack's Project tag.
resource "aws_iam_policy" "workload_boundary" {
  count = var.stack_project != "" ? 1 : 0

  name        = "${var.stack_project}-workload-boundary"
  path        = "/"
  description = "Permission boundary on the roles of InsideOut stack ${var.stack_project} (#147)."
  policy      = jsonencode(jsondecode(templatefile("${path.module}/../account-setup/policies/insideout-workload-boundary.json", { project = var.stack_project })))

  tags = {
    Project   = var.project_id
    ManagedBy = "terraform"
    Purpose   = "insideout-workload-boundary"
  }
}

resource "local_file" "iam_scope_tfvars" {
  count = local.scoped_deploy ? 1 : 0

  filename = "${path.module}/../auto-vars/iam_scope.auto.tfvars.json"
  content  = jsonencode({ iam_scope = local.iam_scope })

  # iam_scope names the boundary by its ARN string; write the file only once
  # the boundary exists, so the composed stack never names a missing policy.
  depends_on = [aws_iam_policy.workload_boundary]
}

output "deploy_policy_mode" {
  description = "Deploy policy on the terraform role: admin or scoped (#194)."
  value       = var.deploy_policy_mode
}

output "iam_scope" {
  description = "IAM path and permissions boundary for the composed stack in scoped mode; null in admin mode (#194)."
  value       = local.iam_scope
}

module "bootstrap" {
  count  = 1
  source = "github.com/luthersystems/tf-modules.git//aws-platform-ui-bootstrap?ref=v55.23.0"

  admin_role_name     = local.admin_role_name
  create_dns          = var.create_dns
  project             = var.short_project_id
  env                 = var.luther_env
  org_name            = var.org_name
  domain              = var.domain
  create_state_bucket = true
  admin_principals    = [var.terraform_sa_role]
  kms_alias_suffix    = format("%s-tfstate", var.short_project_id)

  # #147 Phase 0: the customer-managed InsideOutWrite policy (admin-equivalent
  # body, header comment above) replaces the module's AdministratorAccess
  # attachment on the durable terraform role.
  #
  # deploy_policy_mode = "scoped" (#194) attaches the generated policy
  # instead; see "Deploy policy mode" above.
  deploy_policy_json = local.scoped_deploy ? local.scoped_deploy_policy_json : local.admin_deploy_policy_json

  # #147 Phase 0 (design doc §8.1): deny-only permission boundary — a hard cap
  # that removes only provably-out-of-scope surface (Organizations/Billing
  # control plane, IAM users/login credentials, security-monitoring teardown).
  # Strict superset of real deploy usage ⇒ effective permissions of a real
  # deploy are unchanged. Rollback: set back to "" and re-apply — independent
  # of the policy swap above.
  permissions_boundary_arn = aws_iam_policy.insideout_deploy_boundary.arn

  providers = {
    aws    = aws
    random = random
  }
}

data "aws_route53_zone" "parent" {
  count = var.create_dns ? 1 : 0

  provider = aws.platform-account
  name     = local.base_domain
}

resource "aws_route53_record" "subdomain_ns" {
  count = var.create_dns ? 1 : 0

  provider = aws.platform-account
  zone_id  = data.aws_route53_zone.parent[0].zone_id
  name     = var.domain
  type     = "NS"
  ttl      = 300
  records  = module.bootstrap[0].aws_route53_zone_name_servers
}

# ============================================================================
# AWS Inspector
# ============================================================================

locals {
  inspector_role_name = "insideout-inspector-${var.project_id}"

  inspector_role_arn      = aws_iam_role.insideout_inspector.arn
  inspector_role_name_out = aws_iam_role.insideout_inspector.name
}

data "aws_iam_policy_document" "inspector_assume" {
  statement {
    sid    = "AllowTerraformSAAssume"
    effect = "Allow"

    principals {
      type        = "AWS"
      identifiers = [var.terraform_sa_role]
    }

    actions = ["sts:AssumeRole"]
  }
}

resource "aws_iam_role" "insideout_inspector" {
  name                 = local.inspector_role_name
  description          = "Read-only role for InsideOut infrastructure inspection"
  assume_role_policy   = data.aws_iam_policy_document.inspector_assume.json
  max_session_duration = 3600 # 1 hour

  tags = {
    Project   = var.project_id
    ManagedBy = "terraform"
    Purpose   = "insideout-inspection"
  }

  # AWS doesn't soft-delete IAM roles like GCP does service accounts, but a
  # delete-then-create cycle still breaks any STS session/oracle path that
  # cached the role ARN/path. Mirror the GCP guard for consistency. See #106.
  lifecycle {
    ignore_changes  = [managed_policy_arns]
    prevent_destroy = true
  }
}

resource "aws_iam_role_policy_attachment" "inspector_readonly" {
  role       = aws_iam_role.insideout_inspector.name
  policy_arn = "arn:aws:iam::aws:policy/ReadOnlyAccess"
}

# ============================================================================
# AWS State Backend Configuration
# ============================================================================

locals {
  state_workspace_vm  = "vm"
  state_workspace_k8s = "k8s"

  state_kms_key_id = try(module.bootstrap[0].aws_kms_key_id, "")
  state_role_arn   = local.admin_role_arn

  state = {
    bucket = try(module.bootstrap[0].aws_s3_bucket_tfstate, "")
    region = var.aws_region
  }

  state_backend_vm = merge(local.state, {
    workspace_key_prefix = local.state_workspace_vm
    key                  = format("terraform_%s.tfstate", local.state_workspace_vm)
    kms_key_id           = local.state_kms_key_id,
    role_arn             = local.state_role_arn,
  })

  state_backend_k8s = merge(local.state, {
    workspace_key_prefix = local.state_workspace_k8s
    key                  = format("terraform_%s.tfstate", local.state_workspace_k8s)
    kms_key_id           = local.state_kms_key_id,
    role_arn             = local.state_role_arn,
  })

  state_workspace_custom = "custom"

  state_backend_custom = merge(local.state, {
    workspace_key_prefix = local.state_workspace_custom
    key                  = format("terraform_%s.tfstate", local.state_workspace_custom)
    kms_key_id           = local.state_kms_key_id,
    role_arn             = local.state_role_arn,
  })
}

output "state_workspace_vm" {
  value = local.state_workspace_vm
}

output "state_backend_vm" {
  value = local.state_backend_vm
}

output "state_workspace_custom" {
  description = "Workspace key prefix for the custom-stack remote backend."
  value       = local.state_workspace_custom
}

output "state_backend_custom" {
  description = "Per-stack remote backend config for custom-stack-provision. Cloud-agnostic name; on AWS the map is {bucket, region, key, workspace_key_prefix, kms_key_id, role_arn}."
  value       = local.state_backend_custom
}

resource "local_file" "vm_backend_template" {
  content  = templatefile("backend.tf.tftpl", local.state_backend_vm)
  filename = "${path.module}/../vm-provision/backend.tf"
}

resource "local_file" "k8s_backend_template" {
  content  = templatefile("backend.tf.tftpl", local.state_backend_k8s)
  filename = "${path.module}/../k8s-provision/backend.tf"
}

resource "local_file" "custom_backend_template" {
  content  = templatefile("backend.tf.tftpl", local.state_backend_custom)
  filename = "${path.module}/../custom-stack-provision/backend.tf"
}

# ============================================================================
# AWS Outputs
# ============================================================================

output "terraform_role" {
  description = "AWS IAM role ARN for Terraform"
  value       = local.admin_role_arn
}

output "domain" {
  description = "Domain name for the deployment"
  value       = module.bootstrap[0].domain
}

output "inspector_role_arn" {
  description = "ARN of the InsideOut inspector role"
  value       = local.inspector_role_arn
}

output "inspector_role_name" {
  description = "Name of the InsideOut inspector role"
  value       = local.inspector_role_name_out
}
